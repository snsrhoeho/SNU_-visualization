# 공공데이터포털에서 발급한 일반 인증키(Decoding Key)
DATA_GO_KR_SERVICE_KEY=

# NAVER Cloud Maps Application의 Client ID (Client Secret이 아님)
NAVER_MAPS_KEY_ID=

# 기본값 0.05. 웹 화면에서는 4%, 5%, 6%를 사용자가 선택할 수 있습니다.
DEPOSIT_CONVERSION_RATE=0.05

# OpenAI Responses API (키는 .env와 Cloudtype 환경변수에만 입력)

# Google 로그인: 허용된 계정만 AI 챗봇을 사용합니다.
GOOGLE_CLIENT_ID=
ALLOWED_CHAT_EMAILS=team.member@gmail.com
# Google 가입 없이 팀 전용으로 쓸 때 공유할 코드입니다. 실제 값은 .env/Cloudtype에만 입력하세요.
CHAT_ACCESS_CODE=
COOKIE_SECURE=false
